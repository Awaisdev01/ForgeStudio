{
  "name": "forgecode-gateway",
  "version": "0.6.0",
  "description": "ForgeGateway \u2014 local AI gateway dashboard (study project, personal use)",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win portable nsis"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.forge.forgestudio",
    "productName": "ForgeStudio",
    "icon": "../build/app.icns",
    "directories": {
      "output": "release",
      "app": "app"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "identity": null,
      "sign": false,
      "gatekeeperAssess": false
    }
  }
}